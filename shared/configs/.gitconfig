[gpg]
    format = ssh

[commit]
    gpgsign = true
    verbose = true

[tag]
    gpgsign = true
    sort = version:refname

[pull]
    rebase = false
    ff = only

[push]
    default = simple
    autoSetupRemote = true

[color]
    ui = true

[init]
    defaultBranch = main

[merge]
    conflictstyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = zebra

[branch]
    sort = -committerdate

[rerere]
    enabled = true

[fetch]
    prune = true
    prunetags = true

[rebase]
    autosquash = true
    autostash = true

[core]
    autocrlf = input
    fsmonitor = true
    untrackedcache = true

[alias]
    lg = log --oneline --graph --decorate --all
    recent = branch --sort=-committerdate --format='%(refname:short) %(committerdate:relative)'
    wip = !git add -A && git commit -m "WIP"
    undo = reset --soft HEAD~1
