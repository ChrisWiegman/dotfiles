# Machine-specific settings (machines/<name>/configs/.ssh/config.d/*.conf,
# linked by configs.sh). Included first because ssh uses the first value it
# finds for most options, so these win over the defaults below.
Include ~/.ssh/config.d/*.conf

# GitHub's host keys ship with this repo (known_hosts.d/github.com), so a new
# machine never has to trust whatever key it's shown on first connect. If GitHub
# rotates them, refresh that file from https://api.github.com/meta.
Host github.com
    UserKnownHostsFile ~/.ssh/known_hosts.d/github.com
    StrictHostKeyChecking yes
    UpdateHostKeys no

Host *
    ForwardAgent no
    ForwardX11 no
    ServerAliveInterval 60
    ServerAliveCountMax 10
    AddKeysToAgent yes
    IgnoreUnknown UseKeychain
    UseKeychain yes
    IdentityFile ~/.ssh/id_ed25519
