root = true

# shfmt reads these, so a plain `shfmt -w` keeps the repo's style. It only
# finds *.sh and *.zsh on its own; pass the .zshrc files by name.

# Setup scripts (POSIX sh)
[*.sh]
indent_style = space
indent_size = 4

# zsh configs
[{*.zsh,.zshrc}]
indent_style = space
indent_size = 2
shell_variant = zsh
