[user]
    name = Joy Wiegman
    email = joy@joywiegman.com
    signingkey = ~/.ssh/id_ed25519.pub

# Generated by configs.sh from this machine's key, so `git log --show-signature`
# can verify commits signed here.
[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers

[include]
    path = ~/.dotfiles/shared/configs/.gitconfig
